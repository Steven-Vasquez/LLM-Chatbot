flowchart LR
 subgraph SQL_DB[<b>SQL Database</b>]
        Recent["Recent messages"]
        Topic["Current topic summary"]
  end
 subgraph Vector_DB[<b>ChromaDB Vector Stores</b>]
        MsgVec["Past messages"]
        SumVec["Completed topic summaries"]
  end
 subgraph PromptBuilder[<b>Prompt Builder</b>]
        Split["Separate latest user input"]
        Conv["Format recent conversation text"]
        Retrieve["Semantic retrieval"]
        Rank["Rank and filter retrieved context"]
        Retrieved["Retrieved context"]
        Prompt["Assemble final prompt"]
        Final["Final prompt string"]
        System["System prompt"]
        UserInput["Latest user input"]
  end
    Recent --> Split
    Split --> Conv
    MsgVec --> Retrieve
    SumVec --> Retrieve
    Retrieve --> Rank
    Rank --> Retrieved
    Topic --> Prompt
    Conv --> Prompt
    Retrieved --> Prompt
    System --> Prompt
    UserInput --> Prompt
    Prompt --> Final

